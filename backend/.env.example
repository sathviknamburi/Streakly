# Server Configuration
PORT=5000
NODE_ENV=production

# Database & Security
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/streakly?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# URLs
# URL of your deployed frontend (e.g. on Vercel or Netlify) - NO trailing slash
FRONTEND_URL=https://streakly.vercel.app

# URL of your deployed backend (e.g. on Render) - used for internal keep-alive cron pings
SERVER_URL=https://streakly-backend.onrender.com

# Cron Configuration (Optional)
CRON_TIMEZONE=UTC
CRON_SECRET=your_optional_secret_token_for_external_cron_webhooks
